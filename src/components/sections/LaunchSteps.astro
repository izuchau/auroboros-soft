---
import type { Locale } from '../../types';
import { getTranslations } from '../../i18n/ui';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="launch" class="section-padding bg-bg-card/50">
  <div class="container-main">
    <div class="mb-12 text-center">
      <h2 class="heading-soft mb-4 text-3xl font-bold sm:text-4xl">{t.launchSteps.title}</h2>
      <p class="mx-auto max-w-2xl text-text-muted">{t.launchSteps.subtitle}</p>
    </div>
    <div class="grid gap-6 lg:grid-cols-3 lg:items-stretch">
      {
        t.launchSteps.items.map((item, i) => (
          <article class="card-surface group relative flex h-full min-h-[220px] flex-col overflow-hidden p-6 transition hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 sm:p-8">
            <h3 class="heading-soft relative z-10 mb-3 text-lg font-semibold">{item.title}</h3>
            <p class="relative z-10 flex-1 text-sm leading-relaxed text-text-muted">{item.description}</p>
            <span
              class="pointer-events-none absolute right-4 bottom-2 font-mono text-6xl font-bold leading-none text-primary/10 transition group-hover:text-primary/15 select-none sm:text-7xl"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
          </article>
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <Button href="#contact" size="lg">{t.launchSteps.cta}</Button>
    </div>
  </div>
</section>
