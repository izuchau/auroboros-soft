---
import type { Locale } from '../../types';
import { getTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="services" class="section-padding bg-bg-card/50">
  <div class="container-main">
    <div class="mb-12 text-center">
      <h2 class="heading-soft mb-4 text-3xl font-bold sm:text-4xl">{t.services.title}</h2>
      <p class="mx-auto max-w-2xl text-text-muted">{t.services.subtitle}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        t.services.items.map((item, i) => (
          <article class="card-surface relative overflow-hidden p-6">
            <span class="mb-4 block font-mono text-2xl font-bold text-primary/40">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="heading-soft mb-3 text-xl font-semibold">{item.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
