---
import type { Locale } from '../../types';
import { getTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="about" class="section-padding bg-bg-card/50">
  <div class="container-main">
    <h2 class="heading-soft mb-12 text-center text-3xl font-bold sm:text-4xl">{t.steps.title}</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.steps.items.map((item, i) => (
          <article class="relative card-surface p-6">
            {i < t.steps.items.length - 1 && (
              <div class="absolute top-1/2 -right-3 hidden h-0.5 w-6 bg-border lg:block" />
            )}
            <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 font-mono text-sm font-bold text-primary">
              {i + 1}
            </span>
            <h3 class="heading-soft mb-2 font-semibold">{item.title}</h3>
            <p class="text-sm text-text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section-padding">
  <div class="container-main">
    <h2 class="heading-soft mb-12 text-center text-3xl font-bold sm:text-4xl">{t.benefits.title}</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.benefits.items.map((item) => (
          <article class="card-surface p-6 text-center">
            <h3 class="heading-soft mb-2 font-semibold">{item.title}</h3>
            <p class="text-sm text-text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
