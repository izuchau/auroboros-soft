---
import type { Locale } from '../../types';
import { faqItems } from '../../data/faq';
import { getTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="faq" class="section-padding bg-bg-card/50">
  <div class="container-main max-w-3xl">
    <h2 class="heading-soft mb-12 text-center text-3xl font-bold sm:text-4xl">{t.faq.title}</h2>
    <div class="space-y-3">
      {
        faqItems.map((item, i) => (
          <details class="group card-surface overflow-hidden">
            <summary class="heading-soft flex cursor-pointer list-none items-center justify-between p-5 font-medium marker:content-none">
              {item.question[locale]}
              <span class="ml-4 text-primary transition group-open:rotate-45">+</span>
            </summary>
            <div class="border-t border-border px-5 pb-5 text-sm leading-relaxed text-text-muted">
              {item.answer[locale]}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
