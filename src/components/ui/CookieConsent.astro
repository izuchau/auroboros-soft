---
import type { Locale } from '../../types';
import { getTranslations, localePath } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
const metrikaId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? '';
const privacyPath = localePath(locale, '/privacy');
---

<div
  id="cookie-consent"
  class="cookie-consent fixed inset-x-0 bottom-0 z-[100] hidden translate-y-full opacity-0 transition duration-300"
  role="region"
  aria-label={t.cookies.ariaLabel}
  data-ga-id={gaId}
  data-metrika-id={metrikaId}
  hidden
>
  <div class="border-t border-border bg-bg-card/95 px-4 py-4 shadow-[0_-8px_32px_rgba(0,0,0,0.45)] backdrop-blur-md sm:px-6">
    <div class="container-main">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-3xl text-sm leading-relaxed text-text-muted">
          <p class="mb-1 font-semibold text-text">{t.cookies.title}</p>
          <p>
            {t.cookies.description}{' '}
            <a href={privacyPath} class="text-primary hover:underline">{t.cookies.privacyLink}</a>.
          </p>
          <p class="mt-2 text-xs text-text-dim">{t.cookies.disclaimer}</p>
        </div>
        <button
          type="button"
          class="shrink-0 rounded-xl bg-primary/80 px-6 py-2.5 text-sm font-bold text-bg transition hover:bg-primary-hover/80 lg:min-w-[10rem]"
          data-cookie-action="accept-all"
        >
          {t.cookies.acceptAll}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    COOKIE_CONSENT_KEY,
    parseCookieConsent,
    saveCookieConsent,
    type CookieConsentChoices,
  } from '../../lib/cookieConsent';

  const CONSENT_EVENT = 'auroboros:cookie-consent';

  function loadGoogleAnalytics(measurementId: string) {
    if (!measurementId || document.getElementById('ga-script')) return;

    const script = document.createElement('script');
    script.id = 'ga-script';
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(script);

    const inline = document.createElement('script');
    inline.id = 'ga-inline';
    inline.textContent = `
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${measurementId}', { anonymize_ip: true });
    `;
    document.head.appendChild(inline);
  }

  function loadYandexMetrika(counterId: string) {
    if (!counterId || document.getElementById('ym-script')) return;

    const id = Number(counterId);
    if (!Number.isFinite(id)) return;

    const scriptUrl = `https://mc.yandex.ru/metrika/tag.js?id=${id}`;

    window.ym =
      window.ym ||
      function (...args: unknown[]) {
        (window.ym!.a = window.ym!.a || []).push(args);
      };
    window.ym!.l = Date.now();

    const script = document.createElement('script');
    script.id = 'ym-script';
    script.async = true;
    script.src = scriptUrl;
    document.head.appendChild(script);

    window.ym(id, 'init', {
      webvisor: true,
      clickmap: true,
      accurateTrackBounce: true,
      trackLinks: true,
    });
  }

  function loadMarketingScripts() {
    /* Hook for future ad pixels (Meta, Google Ads, etc.). */
  }

  function applyConsent(consent: CookieConsentChoices, gaId: string, metrikaId: string) {
    if (consent.analytics) {
      loadGoogleAnalytics(gaId);
      loadYandexMetrika(metrikaId);
    }
    if (consent.marketing) loadMarketingScripts();
    window.dispatchEvent(new CustomEvent(CONSENT_EVENT, { detail: consent }));
  }

  function showBanner(root: HTMLElement) {
    root.hidden = false;
    root.classList.remove('hidden');
    requestAnimationFrame(() => {
      root.classList.remove('translate-y-full', 'opacity-0');
    });
  }

  function hideBanner(root: HTMLElement) {
    root.classList.add('translate-y-full', 'opacity-0');
    window.setTimeout(() => {
      root.hidden = true;
      root.classList.add('hidden');
    }, 300);
  }

  function initCookieConsent() {
    const root = document.getElementById('cookie-consent');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const gaId = root.dataset.gaId ?? '';
    const metrikaId = root.dataset.metrikaId ?? '';
    const stored = parseCookieConsent(localStorage.getItem(COOKIE_CONSENT_KEY));

    if (stored) {
      applyConsent(stored, gaId, metrikaId);
    } else {
      showBanner(root);
    }

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest('[data-cookie-action="accept-all"]');
      if (!target) return;

      const consent = saveCookieConsent({ analytics: true, marketing: true });
      applyConsent(consent, gaId, metrikaId);
      hideBanner(root);
    });
  }

  initCookieConsent();
  document.addEventListener('astro:page-load', initCookieConsent);
</script>
