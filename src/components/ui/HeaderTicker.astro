<div class="header-ticker pointer-events-none absolute inset-x-0 bottom-1 hidden md:flex md:justify-center" aria-hidden="true">
  <div class="header-ticker__inner">
    <div id="header-ticker-track" class="header-ticker__track">
    {
      tickerStates[0].items.map((item, index) => (
        <>
          {index > 0 && <span class="header-ticker__sep">·</span>}
          <span class="header-ticker__item">
            <span class="header-ticker__label">{item.label}</span>
            <span class:list={['header-ticker__value', `header-ticker__value--${item.tone}`]}>{item.value}</span>
          </span>
        </>
      ))
    }
  </div>
  </div>
</div>

<script define:vars={{ tickerStates }}>
  function renderTickerState(state) {
    return state.items
      .map((item, index) => {
        const sep = index > 0 ? '<span class="header-ticker__sep">·</span>' : '';
        return `${sep}<span class="header-ticker__item"><span class="header-ticker__label">${item.label}</span><span class="header-ticker__value header-ticker__value--${item.tone}">${item.value}</span></span>`;
      })
      .join('');
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initHeaderTicker() {
    const track = document.getElementById('header-ticker-track');
    if (!track) return;
    if (track.dataset.initialized) return;
    track.dataset.initialized = 'true';

    let index = 0;

    if (prefersReducedMotion()) return;

    window.setInterval(() => {
      index = (index + 1) % tickerStates.length;
      track.style.opacity = '0';

      window.setTimeout(() => {
        track.innerHTML = renderTickerState(tickerStates[index]);
        track.style.opacity = '1';
      }, 420);
    }, 4200);
  }

  initHeaderTicker();
  document.addEventListener('astro:page-load', initHeaderTicker);
</script>
