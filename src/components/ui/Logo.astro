---
interface Props {
  class?: string;
  variant?: 'header' | 'footer' | 'hero';
  glow?: boolean;
  star?: boolean;
  /** `circle` — approved backup; `quasar` — four-point star experiment */
  starVariant?: 'circle' | 'quasar';
}

const { class: className = '', variant = 'header', glow = false, star = true, starVariant = 'quasar' } = Astro.props;

const sizes = {
  header: 'h-14 w-auto max-w-[min(58vw,210px)] sm:h-16 md:h-[7.5rem] md:max-w-[min(72vw,420px)] lg:h-[9rem] lg:max-w-[520px]',
  footer: 'h-16 w-auto max-w-[280px]',
  hero: 'h-44 w-auto sm:h-56 md:h-72 lg:h-80 max-w-[min(92vw,560px)]',
};

const glowClass = glow ? (variant === 'hero' ? 'logo-glow' : 'logo-glow-soft') : '';
---

<span class:list={['logo-mark', `logo-mark--${variant}`, `logo-mark--star-${starVariant}`, className]}>
  <img
    src="/logo.png"
    alt="Auroboros — торговые роботы"
    class:list={[sizes[variant], 'logo-mark__image', 'object-contain', glowClass]}
    loading={variant === 'hero' ? 'eager' : 'lazy'}
    decoding="async"
  />
  {
    star && (
      <span class="logo-mark__emblem-zone" aria-hidden="true">
        <span class="logo-mark__star">
          <span class="logo-mark__ring logo-mark__ring--cyan" />
          <span class="logo-mark__ring logo-mark__ring--soft" />
          <span class="logo-mark__core-wrap">
            <span class="logo-mark__core" />
          </span>
        </span>
      </span>
    )
  }
</span>
