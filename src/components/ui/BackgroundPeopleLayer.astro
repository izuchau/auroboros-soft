---
type Node = {
  x: number;
  y: number;
  tone: 'green' | 'red' | 'watch';
};

type Network = {
  id: string;
  viewBox: string;
  nodes: Node[];
  links: readonly (readonly [number, number])[];
};

const r = 34;

function hexPoints(x: number, y: number, radius: number): string {
  return Array.from({ length: 6 })
    .map((_, i) => {
      const angle = (Math.PI / 3) * i - Math.PI / 6;
      return `${x + radius * Math.cos(angle)},${y + radius * Math.sin(angle)}`;
    })
    .join(' ');
}

function buildViewBox(nodes: Node[], pad: number): string {
  const minX = Math.min(...nodes.map((node) => node.x)) - pad;
  const minY = Math.min(...nodes.map((node) => node.y)) - pad;
  const maxX = Math.max(...nodes.map((node) => node.x)) + pad;
  const maxY = Math.max(...nodes.map((node) => node.y)) + pad;
  return `${minX} ${minY} ${maxX - minX} ${maxY - minY}`;
}

function nodeDistance(a: Node, b: Node): number {
  return Math.hypot(a.x - b.x, a.y - b.y);
}

function segmentHitsHex(
  ax: number,
  ay: number,
  bx: number,
  by: number,
  cx: number,
  cy: number,
  hitRadius: number
): boolean {
  const dx = bx - ax;
  const dy = by - ay;
  const len2 = dx * dx + dy * dy;
  if (len2 === 0) return nodeDistance({ x: ax, y: ay }, { x: cx, y: cy }) < hitRadius;

  const t = Math.max(0, Math.min(1, ((cx - ax) * dx + (cy - ay) * dy) / len2));
  const px = ax + t * dx;
  const py = ay + t * dy;
  return Math.hypot(px - cx, py - cy) < hitRadius;
}

function hexEdgePointToward(
  cx: number,
  cy: number,
  tx: number,
  ty: number,
  radius: number
): { x: number; y: number } {
  const dx = tx - cx;
  const dy = ty - cy;
  const len = Math.hypot(dx, dy);
  if (!len) return { x: cx, y: cy };

  const angle = Math.atan2(dy, dx);
  const sector = Math.PI / 3;
  const local = ((angle + Math.PI / 6) % sector + sector) % sector;
  const dist = (radius * Math.cos(sector / 2)) / Math.cos(local - sector / 2);

  return {
    x: cx + (dx / len) * dist,
    y: cy + (dy / len) * dist,
  };
}

function linkLineCoords(a: Node, b: Node, hexRadius: number) {
  const start = hexEdgePointToward(a.x, a.y, b.x, b.y, hexRadius);
  const end = hexEdgePointToward(b.x, b.y, a.x, a.y, hexRadius);
  return { start, end };
}

function buildNeighborLinks(nodes: Node[], hexRadius: number): readonly (readonly [number, number])[] {
  const hitRadius = hexRadius * 0.82;
  const maxNeighbors = 5;
  const linkSet = new Set<string>();
  const links: [number, number][] = [];

  for (let i = 0; i < nodes.length; i++) {
    const ranked = nodes
      .map((other, j) => ({ j, d: i === j ? Infinity : nodeDistance(nodes[i], other) }))
      .filter(({ d }) => Number.isFinite(d))
      .sort((a, b) => a.d - b.d);

    const first = ranked[0]?.d ?? Infinity;
    const second = ranked[1]?.d ?? first;
    const third = ranked[2]?.d ?? second;
    const neighborCutoff = Math.max(second * 1.08, third * 1.02, first * 1.65);

    let added = 0;
    for (const { j, d } of ranked) {
      if (added >= maxNeighbors) break;
      if (d > neighborCutoff) break;

      const a = Math.min(i, j);
      const b = Math.max(i, j);
      const key = `${a}-${b}`;
      if (linkSet.has(key)) continue;

      const { start, end } = linkLineCoords(nodes[i], nodes[j], hexRadius);
      const blocked = nodes.some((node, k) => {
        if (k === i || k === j) return false;
        return segmentHitsHex(start.x, start.y, end.x, end.y, node.x, node.y, hitRadius);
      });

      if (!blocked) {
        links.push([a, b]);
        linkSet.add(key);
        added += 1;
      }
    }
  }

  return links;
}

const scale = 1.2;
const baseNodes: Node[] = [
  { x: 48, y: 40, tone: 'green' },
  { x: 182, y: 24, tone: 'red' },
  { x: 308, y: 46, tone: 'watch' },
  { x: 404, y: 30, tone: 'red' },
  { x: 90, y: 112, tone: 'red' },
  { x: 236, y: 118, tone: 'green' },
  { x: 364, y: 106, tone: 'green' },
];

const centerX = baseNodes.reduce((sum, node) => sum + node.x, 0) / baseNodes.length;
const centerY = baseNodes.reduce((sum, node) => sum + node.y, 0) / baseNodes.length;

const mainNodes = baseNodes.map(({ x, y, tone }) => ({
  x: Math.round(centerX + (x - centerX) * scale),
  y: Math.round(centerY + (y - centerY) * scale),
  tone,
}));

const mainCenterY = mainNodes.reduce((sum, node) => sum + node.y, 0) / mainNodes.length;
const mobileYSpread = 2.074;

const mainNodesMobile = mainNodes.map(({ x, y, tone }) => ({
  x,
  y: Math.round(mainCenterY + (y - mainCenterY) * mobileYSpread),
  tone,
}));

const mainLinksMobile = buildNeighborLinks(mainNodesMobile, r);

const secondaryNodes: Node[] = [
  { x: 60, y: 30, tone: 'green' },
  { x: 168, y: 16, tone: 'red' },
  { x: 264, y: 38, tone: 'watch' },
  { x: 104, y: 100, tone: 'red' },
  { x: 210, y: 104, tone: 'green' },
];

const pad = r + 12;

const mainLinks = buildNeighborLinks(mainNodes, r);
const secondaryLinks = buildNeighborLinks(secondaryNodes, r);

const networks: Network[] = [
  {
    id: 'main',
    viewBox: buildViewBox(mainNodes, pad),
    nodes: mainNodes,
    links: mainLinks,
  },
  {
    id: 'secondary',
    viewBox: buildViewBox(secondaryNodes, pad),
    nodes: secondaryNodes,
    links: secondaryLinks,
  },
];
---

<div class="live-bg__people pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <svg id="people-bridge-svg" class="live-bg__people-bridge" xmlns="http://www.w3.org/2000/svg"></svg>
  {
    networks.map((network, networkIndex) => (
      <div class:list={['live-bg__people-group', `live-bg__people-group--${network.id}`]}>
        {
          network.id === 'main' ? (
            <>
              <svg
                class="live-bg__people-svg live-bg__people-svg--desktop"
                viewBox={network.viewBox}
                xmlns="http://www.w3.org/2000/svg"
              >
                {
                  network.links.map(([a, b], i) => {
                    const line = linkLineCoords(network.nodes[a], network.nodes[b], r);
                    return (
                      <line
                        class="live-bg__people-link"
                        vector-effect="non-scaling-stroke"
                        x1={line.start.x}
                        y1={line.start.y}
                        x2={line.end.x}
                        y2={line.end.y}
                        style={`animation-delay: ${i * 0.28 + networkIndex * 0.35}s`}
                      />
                    );
                  })
                }
                {
                  network.nodes.map((node, i) => (
                    <g
                      class:list={['live-bg__people-node', `live-bg__people-node--${node.tone}`]}
                      transform={`translate(${node.x} ${node.y})`}
                      data-node={i}
                      style={`animation-delay: ${i * 0.32 + networkIndex * 0.45}s`}
                    >
                      <polygon class="live-bg__people-hex" points={hexPoints(0, 0, r)} />
                      <circle class="live-bg__people-head" cx="0" cy="-5" r="4.2" />
                      <path class="live-bg__people-body" d="M-6 2 Q0 6 6 2 L5 14 Q0 11 -5 14 Z" />
                    </g>
                  ))
                }
              </svg>
              <svg
                class="live-bg__people-svg live-bg__people-svg--mobile"
                viewBox={buildViewBox(mainNodesMobile, pad)}
                xmlns="http://www.w3.org/2000/svg"
              >
                {
                  mainLinksMobile.map(([a, b], i) => {
                    const line = linkLineCoords(mainNodesMobile[a], mainNodesMobile[b], r);
                    return (
                      <line
                        class="live-bg__people-link"
                        vector-effect="non-scaling-stroke"
                        x1={line.start.x}
                        y1={line.start.y}
                        x2={line.end.x}
                        y2={line.end.y}
                        style={`animation-delay: ${i * 0.28 + networkIndex * 0.35}s`}
                      />
                    );
                  })
                }
                {
                  mainNodesMobile.map((node, i) => (
                    <g
                      class:list={['live-bg__people-node', `live-bg__people-node--${node.tone}`]}
                      transform={`translate(${node.x} ${node.y})`}
                      data-node={i}
                      style={`animation-delay: ${i * 0.32 + networkIndex * 0.45}s`}
                    >
                      <polygon class="live-bg__people-hex" points={hexPoints(0, 0, r)} />
                      <circle class="live-bg__people-head" cx="0" cy="-5" r="4.2" />
                      <path class="live-bg__people-body" d="M-6 2 Q0 6 6 2 L5 14 Q0 11 -5 14 Z" />
                    </g>
                  ))
                }
              </svg>
            </>
          ) : (
            <svg class="live-bg__people-svg" viewBox={network.viewBox} xmlns="http://www.w3.org/2000/svg">
              {
                network.links.map(([a, b], i) => {
                  const line = linkLineCoords(network.nodes[a], network.nodes[b], r);
                  return (
                    <line
                      class="live-bg__people-link"
                      vector-effect="non-scaling-stroke"
                      x1={line.start.x}
                      y1={line.start.y}
                      x2={line.end.x}
                      y2={line.end.y}
                      style={`animation-delay: ${i * 0.28 + networkIndex * 0.35}s`}
                    />
                  );
                })
              }
              {
                network.nodes.map((node, i) => (
                  <g
                    class:list={['live-bg__people-node', `live-bg__people-node--${node.tone}`]}
                    transform={`translate(${node.x} ${node.y})`}
                    data-node={i}
                    style={`animation-delay: ${i * 0.32 + networkIndex * 0.45}s`}
                  >
                    <polygon class="live-bg__people-hex" points={hexPoints(0, 0, r)} />
                    <circle class="live-bg__people-head" cx="0" cy="-5" r="4.2" />
                    <path class="live-bg__people-body" d="M-6 2 Q0 6 6 2 L5 14 Q0 11 -5 14 Z" />
                  </g>
                ))
              }
            </svg>
          )
        }
      </div>
    ))
  }
</div>

<script>
  function isVisibleRect(rect) {
    return Boolean(rect && rect.width > 0 && rect.height > 0);
  }

  function isMobileBridge() {
    return window.matchMedia('(max-width: 767px)').matches;
  }

  function getNodeAnchor(networkId, nodeIndex) {
    const group = document.querySelector(`.live-bg__people-group--${networkId}`);
    const nodeSelector =
      networkId === 'main'
        ? `.live-bg__people-svg--desktop [data-node="${nodeIndex}"]`
        : `[data-node="${nodeIndex}"]`;
    const node = group?.querySelector(nodeSelector);
    const container = document.querySelector('.live-bg__people');
    if (!node || !container || !group) return null;

    const groupRect = group.getBoundingClientRect();
    if (!isVisibleRect(groupRect)) return null;

    const nodeRect = node.getBoundingClientRect();
    if (!isVisibleRect(nodeRect)) return null;

    const boxRect = container.getBoundingClientRect();

    return {
      x: nodeRect.left + nodeRect.width / 2 - boxRect.left,
      y: nodeRect.top + nodeRect.height / 2 - boxRect.top,
      r: Math.min(nodeRect.width, nodeRect.height) * 0.48,
      el: node,
      networkId,
      nodeIndex,
    };
  }

  function hexEdgePointToward(cx, cy, tx, ty, radius) {
    const dx = tx - cx;
    const dy = ty - cy;
    const len = Math.hypot(dx, dy);
    if (!len) return { x: cx, y: cy };

    const angle = Math.atan2(dy, dx);
    const sector = Math.PI / 3;
    const local = ((angle + Math.PI / 6) % sector + sector) % sector;
    const dist = (radius * Math.cos(sector / 2)) / Math.cos(local - sector / 2);

    return {
      x: cx + (dx / len) * dist,
      y: cy + (dy / len) * dist,
    };
  }

  function getNodeCenter(networkId, nodeIndex) {
    const anchor = getNodeAnchor(networkId, nodeIndex);
    if (!anchor) return null;
    return { x: anchor.x, y: anchor.y };
  }

  function segmentHitsCircle(x1, y1, x2, y2, cx, cy, radius) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const len2 = dx * dx + dy * dy;
    if (!len2) return Math.hypot(cx - x1, cy - y1) < radius;

    const t = Math.max(0, Math.min(1, ((cx - x1) * dx + (cy - y1) * dy) / len2));
    const px = x1 + t * dx;
    const py = y1 + t * dy;
    return Math.hypot(px - cx, py - cy) < radius;
  }

  function collectHexAnchors(container) {
    const anchors = [];

    container.querySelectorAll('.live-bg__people-svg--desktop [data-node]').forEach((node) => {
      const nodeIndex = Number(node.getAttribute('data-node'));
      const anchor = getNodeAnchor('main', nodeIndex);
      if (anchor) anchors.push(anchor);
    });

    container.querySelectorAll('.live-bg__people-group--secondary [data-node]').forEach((node) => {
      const nodeIndex = Number(node.getAttribute('data-node'));
      const anchor = getNodeAnchor('secondary', nodeIndex);
      if (anchor) anchors.push(anchor);
    });

    return anchors;
  }

  function bridgeLineClear(from, to, fromEl, toEl, anchors) {
    return !anchors.some((anchor) => {
      if (anchor.el === fromEl || anchor.el === toEl) return false;
      return segmentHitsCircle(from.x, from.y, to.x, to.y, anchor.x, anchor.y, anchor.r * 0.82);
    });
  }

  function buildScreenBridgeLinks(container) {
    const mainNodes = container.querySelectorAll('.live-bg__people-svg--desktop [data-node]');
    const secondaryNodes = container.querySelectorAll('.live-bg__people-group--secondary [data-node]');
    const anchors = collectHexAnchors(container);
    const candidates = [];

    mainNodes.forEach((mainNode) => {
      const mainIndex = Number(mainNode.getAttribute('data-node'));
      const from = getNodeAnchor('main', mainIndex);
      if (!from) return;

      secondaryNodes.forEach((secondaryNode) => {
        const secIndex = Number(secondaryNode.getAttribute('data-node'));
        const to = getNodeAnchor('secondary', secIndex);
        if (!to) return;

        const fromEdge = hexEdgePointToward(from.x, from.y, to.x, to.y, from.r);
        const toEdge = hexEdgePointToward(to.x, to.y, from.x, from.y, to.r);
        if (!bridgeLineClear(fromEdge, toEdge, from.el, to.el, anchors)) return;

        candidates.push({
          from: fromEdge,
          to: toEdge,
          d: Math.hypot(toEdge.x - fromEdge.x, toEdge.y - fromEdge.y),
          mi: mainIndex,
          si: secIndex,
        });
      });
    });

    candidates.sort((a, b) => a.d - b.d);

    const picked = [];
    const usedMain = new Set();
    const usedSec = new Set();

    for (const candidate of candidates) {
      if (picked.length >= 3) break;
      if (usedMain.has(candidate.mi) || usedSec.has(candidate.si)) continue;
      picked.push(candidate);
      usedMain.add(candidate.mi);
      usedSec.add(candidate.si);
    }

    return picked;
  }

  function drawPeopleBridge() {
    const svg = document.getElementById('people-bridge-svg');
    const container = document.querySelector('.live-bg__people');
    if (!svg || !container) return;

    if (isMobileBridge()) {
      svg.innerHTML = '';
      return;
    }

    const width = container.clientWidth;
    const height = container.clientHeight;
    if (!width || !height) return;

    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

    const lines = buildScreenBridgeLinks(container)
      .map(({ from, to }, i) =>
        `<line class="live-bg__people-bridge-link" vector-effect="non-scaling-stroke" x1="${from.x}" y1="${from.y}" x2="${to.x}" y2="${to.y}" style="animation-delay:${i * 0.32}s"></line>`
      )
      .join('');

    svg.innerHTML = lines;
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initPeopleBridge() {
    const svg = document.getElementById('people-bridge-svg');
    if (!svg || svg.dataset.initialized) return;
    svg.dataset.initialized = 'true';

    let rafId = 0;
    let lastDraw = 0;

    function tick(now) {
      if (now - lastDraw > 80) {
        drawPeopleBridge();
        lastDraw = now;
      }
      rafId = requestAnimationFrame(tick);
    }

    drawPeopleBridge();

    if (!prefersReducedMotion()) {
      rafId = requestAnimationFrame(tick);
    }

    window.addEventListener('resize', drawPeopleBridge, { passive: true });
  }

  initPeopleBridge();
  document.addEventListener('astro:page-load', initPeopleBridge);
</script>
