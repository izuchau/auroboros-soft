---
import type { Locale } from '../../types';
import { getTranslations, localePath } from '../../i18n/ui';
import Logo from '../ui/Logo.astro';
import SocialLinks from '../ui/SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-card">
  <div class="container-main section-padding !py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <div class="mb-4">
          <Logo variant="footer" glow={true} />
        </div>
        <div class="space-y-0.5 text-sm text-text-muted">
          {t.footer.taglineLines.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted">{t.footer.links}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#products" class="text-text-muted transition hover:text-primary">{t.nav.products}</a></li>
          <li><a href="#contact" class="text-text-muted transition hover:text-primary">{t.nav.contact}</a></li>
          <li>
            <a href={localePath(locale, '/privacy')} class="text-text-muted transition hover:text-primary"
              >{t.footer.privacy}</a
            >
          </li>
          <li>
            <a href={localePath(locale, '/terms')} class="text-text-muted transition hover:text-primary"
              >{t.footer.terms}</a
            >
          </li>
          <li>
            <a href={localePath(locale, '/nda')} class="text-text-muted transition hover:text-primary">{t.footer.nda}</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted">{t.footer.contactHeading}</h3>
        <a href="mailto:auroboros.soft@gmail.com" class="text-sm text-primary hover:underline"
          >auroboros.soft@gmail.com</a
        >
        <div class="mt-5">
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted">{t.footer.social}</h3>
          <SocialLinks locale={locale} />
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-main px-4 py-6 sm:px-6 lg:px-8">
      <section class="text-xs leading-relaxed text-text-dim" aria-label={t.footer.disclaimer.title}>
        <h3 class="mb-3 text-sm font-medium text-text-muted">{t.footer.disclaimer.title}</h3>
        <p class="mb-3">{t.footer.disclaimer.intro}</p>
        <ul class="mb-3 list-disc space-y-1.5 pl-5">
          {t.footer.disclaimer.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {t.footer.disclaimer.paragraphs.map((paragraph) => (
          <p class="mb-3 last:mb-0">{paragraph}</p>
        ))}
      </section>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-main px-4 py-6 text-center text-xs text-text-dim sm:px-6 lg:px-8">
      © {year} Auroboros Soft. {t.footer.rights}.
    </div>
  </div>
</footer>
