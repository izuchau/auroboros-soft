---
import type { Locale } from '../../types';
import { getTranslations, localePath } from '../../i18n/ui';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
  formId?: string;
  showTitle?: boolean;
  hiddenProductId?: string;
  hiddenProductName?: string;
}

const {
  locale,
  formId = 'contact-form',
  showTitle = true,
  hiddenProductId = '',
  hiddenProductName = '',
} = Astro.props;

const t = getTranslations(locale);
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? 'mwlevlbw';
const formAction = `https://formspree.io/f/${formspreeId}`;
---

<form
  id={formId}
  class="contact-form space-y-4"
  action={formAction}
  method="POST"
  data-success={t.contact.success}
  data-error={t.contact.error}
  data-phone-invalid={t.contact.phoneInvalid}
  data-not-robot-required={t.contact.captchaRequired}
>
  <input type="hidden" name="_subject" value="Auroboros Soft — новая заявка" />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="product_id" id={`${formId}-product-id`} value={hiddenProductId} />
  <input type="hidden" name="product_name" id={`${formId}-product-name`} value={hiddenProductName} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  {
    showTitle && (
      <div class="mb-6 text-center">
        <h2 class="heading-soft mb-2 text-3xl font-bold">{t.contact.title}</h2>
        <p class="text-text-muted">{t.contact.subtitle}</p>
      </div>
    )
  }

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.name} *</span>
      <input
        type="text"
        name="name"
        required
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      />
    </label>
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.email} *</span>
      <input
        type="email"
        name="email"
        required
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      />
    </label>
  </div>

  <label class="block">
    <span class="mb-1.5 block text-sm text-text-muted">{t.contact.phone} *</span>
    <input
      type="tel"
      name="phone"
      required
      autocomplete="tel"
      inputmode="tel"
      placeholder={t.contact.phonePlaceholder}
      class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
    />
  </label>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.type}</span>
      <select
        name="request_type"
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      >
        <option value="ready">{t.contact.typeReady}</option>
        <option value="custom">{t.contact.typeCustom}</option>
        <option value="consult">{t.contact.typeConsult}</option>
      </select>
    </label>
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.market}</span>
      <select
        name="market"
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      >
        {
          t.contact.marketOptions.map((option) => (
            <option value={option}>{option}</option>
          ))
        }
      </select>
    </label>
  </div>

  <label class="block" id={`${formId}-product-field`} hidden={!hiddenProductName}>
    <span class="mb-1.5 block text-sm text-text-muted">{t.contact.product}</span>
    <input
      type="text"
      name="product_display"
      id={`${formId}-product-display`}
      readonly
      value={hiddenProductName}
      class="w-full rounded-xl border border-border bg-bg px-4 py-3 text-sm text-text-muted outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1.5 block text-sm text-text-muted">
      {t.contact.message}
      <span class="text-text-dim"> ({t.contact.optional})</span>
    </span>
    <textarea
      name="message"
      rows="4"
      placeholder={t.contact.messagePlaceholder}
      class="w-full resize-none rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
    ></textarea>
  </label>

  <label class="flex items-start gap-3 text-sm text-text-muted">
    <input type="checkbox" name="not_robot" required class="mt-1 rounded border-border" />
    <span>{t.contact.notRobot}</span>
  </label>

  <label class="flex items-start gap-3 text-sm text-text-muted">
    <input type="checkbox" name="consent" required class="mt-1 rounded border-border" />
    <span>
      {t.contact.consent}{' '}
      <a href={localePath(locale, '/privacy')} class="text-primary hover:underline">{t.contact.privacyLink}</a>
      {' '}{t.contact.consentAnd}{' '}
      <a href={localePath(locale, '/terms')} class="text-primary hover:underline">{t.contact.termsLink}</a>
    </span>
  </label>

  <p class="form-status hidden rounded-xl px-4 py-3 text-sm" aria-live="polite"></p>

  <Button type="submit" class="w-full sm:w-auto">{t.contact.submit}</Button>
</form>
