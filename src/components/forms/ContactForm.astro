---
import type { Locale } from '../../types';
import { getTranslations, localePath } from '../../i18n/ui';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
  formId?: string;
  showTitle?: boolean;
  hiddenProductId?: string;
  hiddenProductName?: string;
}

const {
  locale,
  formId = 'contact-form',
  showTitle = true,
  hiddenProductId = '',
  hiddenProductName = '',
} = Astro.props;

const t = getTranslations(locale);
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? 'mwlevlbw';
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? '';
const formAction = `https://formspree.io/f/${formspreeId}`;
const captchaEnabled = Boolean(recaptchaSiteKey);
---

<form
  id={formId}
  class="contact-form space-y-4"
  action={formAction}
  method="POST"
  data-success={t.contact.success}
  data-error={t.contact.error}
  data-captcha-required={t.contact.captchaRequired}
  data-captcha-enabled={captchaEnabled ? 'true' : 'false'}
>
  <input type="hidden" name="_subject" value="Auroboros Soft — новая заявка" />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="product_id" id={`${formId}-product-id`} value={hiddenProductId} />
  <input type="hidden" name="product_name" id={`${formId}-product-name`} value={hiddenProductName} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  {
    showTitle && (
      <div class="mb-6 text-center">
        <h2 class="heading-soft mb-2 text-3xl font-bold">{t.contact.title}</h2>
        <p class="text-text-muted">{t.contact.subtitle}</p>
      </div>
    )
  }

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.name} *</span>
      <input
        type="text"
        name="name"
        required
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      />
    </label>
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.email} *</span>
      <input
        type="email"
        name="email"
        required
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      />
    </label>
  </div>

  <label class="block">
    <span class="mb-1.5 block text-sm text-text-muted">
      {t.contact.phone}
      <span class="text-text-dim"> ({t.contact.optional})</span>
    </span>
    <input
      type="tel"
      name="phone"
      autocomplete="tel"
      class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
    />
  </label>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.type}</span>
      <select
        name="request_type"
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      >
        <option value="ready">{t.contact.typeReady}</option>
        <option value="custom">{t.contact.typeCustom}</option>
        <option value="consult">{t.contact.typeConsult}</option>
      </select>
    </label>
    <label class="block">
      <span class="mb-1.5 block text-sm text-text-muted">{t.contact.market}</span>
      <select
        name="market"
        class="w-full rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
      >
        {
          t.contact.marketOptions.map((option) => (
            <option value={option}>{option}</option>
          ))
        }
      </select>
    </label>
  </div>

  <label class="block" id={`${formId}-product-field`} hidden={!hiddenProductName}>
    <span class="mb-1.5 block text-sm text-text-muted">{t.contact.product}</span>
    <input
      type="text"
      name="product_display"
      id={`${formId}-product-display`}
      readonly
      value={hiddenProductName}
      class="w-full rounded-xl border border-border bg-bg px-4 py-3 text-sm text-text-muted outline-none"
    />
  </label>

  <label class="block">
    <span class="mb-1.5 block text-sm text-text-muted">
      {t.contact.message}
      <span class="text-text-dim"> ({t.contact.optional})</span>
    </span>
    <textarea
      name="message"
      rows="4"
      placeholder={t.contact.messagePlaceholder}
      class="w-full resize-none rounded-xl border border-border bg-bg-elevated px-4 py-3 text-sm outline-none transition focus:border-primary"
    ></textarea>
  </label>

  {
    captchaEnabled && (
      <div class="flex justify-center">
        <div
          class="g-recaptcha overflow-hidden rounded-xl"
          data-sitekey={recaptchaSiteKey}
          data-theme="dark"
          id={`${formId}-recaptcha`}
        ></div>
      </div>
    )
  }

  <label class="flex items-start gap-3 text-sm text-text-muted">
    <input type="checkbox" name="consent" required class="mt-1 rounded border-border" />
    <span>
      {t.contact.consent}{' '}
      <a href={localePath(locale, '/privacy')} class="text-primary hover:underline">{t.contact.privacyLink}</a>
      {' '}{t.contact.consentAnd}{' '}
      <a href={localePath(locale, '/terms')} class="text-primary hover:underline">{t.contact.termsLink}</a>
    </span>
  </label>

  <p class="form-status hidden rounded-xl px-4 py-3 text-sm" aria-live="polite"></p>

  <Button type="submit" class="w-full sm:w-auto">{t.contact.submit}</Button>
</form>

{
  captchaEnabled && (
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  )
}

<script define:vars={{ recaptchaSiteKey }}>
  function resetRecaptcha(form) {
    if (typeof grecaptcha !== 'undefined') {
      const widget = form.querySelector('.g-recaptcha');
      if (widget) {
        try {
          grecaptcha.reset();
        } catch {
          /* widget not ready */
        }
      }
    }
  }

  function getRecaptchaToken(form) {
    const field = form.querySelector('textarea[name="g-recaptcha-response"]');
    return field?.value?.trim() ?? '';
  }

  function initContactForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';

      const status = form.querySelector('.form-status');
      const successMsg = form.dataset.success ?? 'Sent';
      const errorMsg = form.dataset.error ?? 'Error';
      const captchaRequiredMsg = form.dataset.captchaRequired ?? errorMsg;
      const captchaEnabled = form.dataset.captchaEnabled === 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!status) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        status.className = 'form-status rounded-xl px-4 py-3 text-sm bg-bg-elevated text-text-muted';
        status.textContent = '...';
        status.classList.remove('hidden');

        try {
          if (captchaEnabled && !getRecaptchaToken(form)) {
            throw new Error(captchaRequiredMsg);
          }

          const formData = new FormData(form);

          const email = formData.get('email');
          if (email) {
            formData.set('_replyto', String(email));
          }

          for (const [key, value] of [...formData.entries()]) {
            if (key.startsWith('_') || key === 'consent' || key === 'name' || key === 'email') continue;
            if (key === 'g-recaptcha-response') continue;
            if (!value || String(value).trim() === '') {
              formData.delete(key);
            }
          }

          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          const data = await response.json().catch(() => ({}));

          if (response.ok) {
            status.className =
              'form-status rounded-xl px-4 py-3 text-sm bg-accent/10 text-accent border border-accent/20';
            status.textContent = successMsg;
            form.reset();
            resetRecaptcha(form);

            if (form.id === 'order-contact-form') {
              setTimeout(() => {
                document.getElementById('order-modal-close')?.click();
              }, 4000);
            }
          } else {
            const detail =
              typeof data.error === 'string'
                ? data.error
                : Array.isArray(data.errors)
                  ? data.errors.map((e) => e.message).join(', ')
                  : errorMsg;
            throw new Error(detail);
          }
        } catch (error) {
          status.className =
            'form-status rounded-xl px-4 py-3 text-sm bg-red-500/10 text-red-400 border border-red-500/20';
          status.textContent = error instanceof Error ? error.message : errorMsg;
          resetRecaptcha(form);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
