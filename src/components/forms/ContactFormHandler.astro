---
const smartCaptchaClientKey = import.meta.env.PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY ?? '';
const captchaEnabled = Boolean(smartCaptchaClientKey);
---

{
  captchaEnabled && (
    <>
      <script is:inline>
        window.initSmartCaptcha = function () {
          if (!window.smartCaptcha) return;

          document.querySelectorAll('[data-smart-captcha]:not([data-rendered])').forEach((el) => {
            const sitekey = el.dataset.sitekey;
            if (!sitekey) return;

            const widgetId = window.smartCaptcha.render(el, {
              sitekey,
              hl: 'ru',
            });

            el.dataset.rendered = 'true';
            el.dataset.widgetId = String(widgetId);
          });
        };
      </script>
      <script
        src="https://smartcaptcha.cloud.yandex.ru/captcha.js?render=onload&onload=initSmartCaptcha"
        defer
      />
    </>
  )
}

<script define:vars={{ captchaEnabled }}>
  function resetSmartCaptcha(form) {
    const api = window.smartCaptcha;
    const widget = form.querySelector('[data-smart-captcha]');
    if (!api || !widget?.dataset.widgetId) return;

    try {
      api.reset(Number(widget.dataset.widgetId));
    } catch {
      /* widget not ready */
    }
  }

  function getSmartCaptchaToken(form) {
    return form.querySelector('input[name="smart-token"]')?.value?.trim() ?? '';
  }

  function initContactForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';

      const status = form.querySelector('.form-status');
      const successMsg = form.dataset.success ?? 'Sent';
      const errorMsg = form.dataset.error ?? 'Error';
      const captchaRequiredMsg = form.dataset.captchaRequired ?? errorMsg;
      const formCaptchaEnabled = form.dataset.captchaEnabled === 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!status) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        status.className = 'form-status rounded-xl px-4 py-3 text-sm bg-bg-elevated text-text-muted';
        status.textContent = '...';
        status.classList.remove('hidden');

        try {
          if (formCaptchaEnabled && !getSmartCaptchaToken(form)) {
            throw new Error(captchaRequiredMsg);
          }

          const formData = new FormData(form);

          const email = formData.get('email');
          if (email) {
            formData.set('_replyto', String(email));
          }

          for (const [key, value] of [...formData.entries()]) {
            if (key.startsWith('_') || key === 'consent' || key === 'name' || key === 'email') continue;
            if (key === 'smart-token') continue;
            if (!value || String(value).trim() === '') {
              formData.delete(key);
            }
          }

          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          const data = await response.json().catch(() => ({}));

          if (response.ok) {
            status.className =
              'form-status rounded-xl px-4 py-3 text-sm bg-accent/10 text-accent border border-accent/20';
            status.textContent = successMsg;
            form.reset();
            resetSmartCaptcha(form);

            if (form.id === 'order-contact-form') {
              setTimeout(() => {
                document.getElementById('order-modal-close')?.click();
              }, 4000);
            }
          } else {
            const detail =
              typeof data.error === 'string'
                ? data.error
                : Array.isArray(data.errors)
                  ? data.errors.map((e) => e.message).join(', ')
                  : errorMsg;
            throw new Error(detail);
          }
        } catch (error) {
          status.className =
            'form-status rounded-xl px-4 py-3 text-sm bg-red-500/10 text-red-400 border border-red-500/20';
          status.textContent = error instanceof Error ? error.message : errorMsg;
          resetSmartCaptcha(form);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
