<script>
  function isValidPhone(value) {
    const trimmed = String(value).trim();
    if (!trimmed || /[a-zA-Zа-яА-ЯёЁ]/.test(trimmed)) return false;

    const digits = trimmed.replace(/\D/g, '');
    if (digits.length < 10 || digits.length > 15) return false;
    if (/^(\d)\1{9,}$/.test(digits)) return false;

    if (digits.length === 11 && /^[78]/.test(digits)) return true;
    if (digits.length === 10 && /^9/.test(digits)) return true;
    if (trimmed.startsWith('+') && digits.length >= 10) return true;

    return digits.length >= 10;
  }

  function initContactForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';

      const status = form.querySelector('.form-status');
      const successMsg = form.dataset.success ?? 'Sent';
      const errorMsg = form.dataset.error ?? 'Error';
      const phoneInvalidMsg = form.dataset.phoneInvalid ?? errorMsg;
      const notRobotRequiredMsg = form.dataset.notRobotRequired ?? errorMsg;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!status) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        status.className = 'form-status rounded-xl px-4 py-3 text-sm bg-bg-elevated text-text-muted';
        status.textContent = '...';
        status.classList.remove('hidden');

        try {
          const honeypot = form.querySelector('input[name="_gotcha"]');
          if (honeypot?.value?.trim()) {
            throw new Error(errorMsg);
          }

          const phoneInput = form.querySelector('input[name="phone"]');
          const phone = phoneInput?.value ?? '';
          if (!isValidPhone(phone)) {
            throw new Error(phoneInvalidMsg);
          }

          const notRobot = form.querySelector('input[name="not_robot"]');
          if (!notRobot?.checked) {
            throw new Error(notRobotRequiredMsg);
          }

          const formData = new FormData(form);

          const email = formData.get('email');
          if (email) {
            formData.set('_replyto', String(email));
          }

          for (const [key, value] of [...formData.entries()]) {
            if (key.startsWith('_') || key === 'consent' || key === 'not_robot' || key === 'name' || key === 'email') {
              continue;
            }
            if (!value || String(value).trim() === '') {
              formData.delete(key);
            }
          }

          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          const data = await response.json().catch(() => ({}));

          if (response.ok) {
            status.className =
              'form-status rounded-xl px-4 py-3 text-sm bg-accent/10 text-accent border border-accent/20';
            status.textContent = successMsg;
            form.reset();

            if (form.id === 'order-contact-form') {
              setTimeout(() => {
                document.getElementById('order-modal-close')?.click();
              }, 4000);
            }
          } else {
            const detail =
              typeof data.error === 'string'
                ? data.error
                : Array.isArray(data.errors)
                  ? data.errors.map((e) => e.message).join(', ')
                  : errorMsg;
            throw new Error(detail);
          }
        } catch (error) {
          status.className =
            'form-status rounded-xl px-4 py-3 text-sm bg-red-500/10 text-red-400 border border-red-500/20';
          status.textContent = error instanceof Error ? error.message : errorMsg;
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
