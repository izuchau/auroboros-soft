---
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? '';
const captchaEnabled = Boolean(recaptchaSiteKey);
---

{
  captchaEnabled && (
    <script src="https://www.google.com/recaptcha/enterprise.js?hl=ru" async defer></script>
  )
}

<script define:vars={{ captchaEnabled }}>
  function getRecaptchaApi() {
    return window.grecaptcha?.enterprise;
  }

  function resetRecaptcha(form) {
    const api = getRecaptchaApi();
    const widget = form.querySelector('.g-recaptcha');
    if (!api || !widget) return;

    const widgets = document.querySelectorAll('.g-recaptcha');
    let widgetId = 0;
    widgets.forEach((el, index) => {
      if (el === widget) widgetId = index;
    });

    try {
      api.reset(widgetId);
    } catch {
      /* widget not ready */
    }
  }

  function getRecaptchaToken(form) {
    const field = form.querySelector('textarea[name="g-recaptcha-response"]');
    return field?.value?.trim() ?? '';
  }

  function initContactForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';

      const status = form.querySelector('.form-status');
      const successMsg = form.dataset.success ?? 'Sent';
      const errorMsg = form.dataset.error ?? 'Error';
      const captchaRequiredMsg = form.dataset.captchaRequired ?? errorMsg;
      const formCaptchaEnabled = form.dataset.captchaEnabled === 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!status) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        status.className = 'form-status rounded-xl px-4 py-3 text-sm bg-bg-elevated text-text-muted';
        status.textContent = '...';
        status.classList.remove('hidden');

        try {
          if (formCaptchaEnabled && !getRecaptchaToken(form)) {
            throw new Error(captchaRequiredMsg);
          }

          const formData = new FormData(form);

          const email = formData.get('email');
          if (email) {
            formData.set('_replyto', String(email));
          }

          for (const [key, value] of [...formData.entries()]) {
            if (key.startsWith('_') || key === 'consent' || key === 'name' || key === 'email') continue;
            if (key === 'g-recaptcha-response') continue;
            if (!value || String(value).trim() === '') {
              formData.delete(key);
            }
          }

          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          const data = await response.json().catch(() => ({}));

          if (response.ok) {
            status.className =
              'form-status rounded-xl px-4 py-3 text-sm bg-accent/10 text-accent border border-accent/20';
            status.textContent = successMsg;
            form.reset();
            resetRecaptcha(form);

            if (form.id === 'order-contact-form') {
              setTimeout(() => {
                document.getElementById('order-modal-close')?.click();
              }, 4000);
            }
          } else {
            const detail =
              typeof data.error === 'string'
                ? data.error
                : Array.isArray(data.errors)
                  ? data.errors.map((e) => e.message).join(', ')
                  : errorMsg;
            throw new Error(detail);
          }
        } catch (error) {
          status.className =
            'form-status rounded-xl px-4 py-3 text-sm bg-red-500/10 text-red-400 border border-red-500/20';
          status.textContent = error instanceof Error ? error.message : errorMsg;
          resetRecaptcha(form);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
