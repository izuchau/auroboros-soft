---
import '../styles/global.css';
import type { Locale } from '../types';
import { getTranslations, localePath } from '../i18n/ui';
import {
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  absoluteUrl,
  buildSiteStructuredData,
} from '../lib/seo';
import LiveBackground from '../components/ui/LiveBackground.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';
import JsonLd from '../components/seo/JsonLd.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}

const { locale, title, description, structuredData } = Astro.props;
const t = getTranslations(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const site = Astro.site ?? new URL('https://auroboros-soft.vercel.app');
const canonicalURL = new URL(Astro.url.pathname, site);
const alternateRu = new URL(localePath('ru', Astro.url.pathname.replace(/^\/(ru|en)/, '')), site);
const alternateEn = new URL(localePath('en', Astro.url.pathname.replace(/^\/(ru|en)/, '')), site);
const ogImageURL = absoluteUrl(OG_IMAGE_PATH, site);
const jsonLd = structuredData ?? buildSiteStructuredData(site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="mROOTO4ObgqYhSlmH_BKLFfbKv5xbYbfvex4zg-Oji4" />
    <meta name="description" content={pageDescription} />
    {'keywords' in t.meta && t.meta.keywords && <meta name="keywords" content={t.meta.keywords} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/logo-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ru" href={alternateRu} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateRu} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Auroboros Soft" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <JsonLd data={jsonLd} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-bg">
    <LiveBackground />
    <div class="relative z-0">
      <slot />
    </div>
    <CookieConsent locale={locale} />
  </body>
</html>
