# Formspree: https://formspree.io/f/mwlevlbw
PUBLIC_FORMSPREE_ID=mwlevlbw

# reCAPTCHA v2 Site Key (галочка в форме) — https://www.google.com/recaptcha/admin
# Secret Key — только в Formspree → Settings → CAPTCHA → Custom reCAPTCHA Key
PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics 4 — загружается только после согласия пользователя в баннере cookie
# ID вида G-XXXXXXXXXX из https://analytics.google.com
PUBLIC_GA_MEASUREMENT_ID=

# Яндекс.Метрика — загружается только после согласия пользователя в баннере cookie
# Номер счётчика из https://metrika.yandex.ru
PUBLIC_YANDEX_METRIKA_ID=
